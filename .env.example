# Configuracion del Profesor de Ingles
# Copia este archivo a .env y completa los valores

# Puerto del servidor Flask (Render asigna uno automaticamente)
PORT=5000

# Clave secreta de Flask (Render la genera automaticamente)
FLASK_SECRET=profesor-ingles-secret-cambiar-en-produccion

# Voz TTS por defecto (Edge TTS de Microsoft)
# Opciones: es-US-PalomaNeural, es-MX-DaliaNeural, es-MX-JorgeNeural
TTS_VOICE=es-US-PalomaNeural

# Opcional: Para Supabase en la nube
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_KEY=tu-clave-anon
